<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- [LibraryImport] 源生成式 P/Invoke 需要 unsafe 代码块（SYSLIB1062） -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Native AOT 兼容声明（库项目，实际 AOT 编译在可执行项目上） -->
		<IsAotCompatible>true</IsAotCompatible>

		<!-- NuGet 包元数据（2026-09 起引擎经 NuGet 分发，替代 4-DLL zip 模式） -->
		<!-- CI 发布时以 -p:Version=<tag> 覆盖版本 -->
		<Version>0.3.0</Version>
		<PackageId>LingFanEngine</PackageId>
		<Authors>MoFeng-02</Authors>
		<Description>灵泛引擎——跨平台可视化小说引擎（Avalonia / .NET 10 / Native AOT）</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MoFeng-02/LingFanEngine</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MoFeng-02/LingFanEngine</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>visual-novel;engine;avalonia;cross-platform</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<!-- 排除旧目录 -->
		<AvaloniaXaml Remove="nupkgs\**" />
		<Compile Remove="nupkgs\**" />
		<Compile Remove="Services\Commands\**" />
		<EmbeddedResource Remove="nupkgs\**" />
		<EmbeddedResource Remove="Services\Commands\**" />
		<None Remove="nupkgs\**" />
		<None Remove="Services\Commands\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 防止裁剪器删除 JsonAOT 序列化器 / 媒体互操作（保留清单见 ILLink.Descriptors.xml） -->
		<!--<TrimmerRootAssembly Include="LingFanEngine.Abstractions" />-->
		<TrimmerRootDescriptor Include="$(LfILLinkDescriptor)" Condition="Exists('$(LfILLinkDescriptor)')" />

		<!-- 保留 System.IO.Compression（DLC ZIP 操作在 AOT 下所需） -->
		<!--<TrimmerRootAssembly Include="System.IO.Compression" />-->
		<!-- 保留 NativeLibrary/Marshal 互操作路径 -->
		<!--<DirectPInvoke Include="*" />-->
		<!-- 保留 Regex 源生成器（[GeneratedRegex] 编译期生成） -->
	</ItemGroup>

	<ItemGroup>
		<DirectPInvoke Remove="nupkgs\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="publish-pack.bat" />
		<None Remove="publish.bat" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="ThisAssembly" Version="2.1.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LingFanEngine.Abstractions\LingFanEngine.Abstractions.csproj" />
		<ProjectReference Include="..\LingFanEngine.DslCore\LingFanEngine.DslCore.csproj" />
	</ItemGroup>
	<!-- Parlot 经 DslCore 的 PackageReference 传递（NuGet 管理，无本地 DLL） -->
</Project>
