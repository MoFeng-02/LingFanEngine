<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LingFanEngine.SDK.ViewModels"
             x:Class="LingFanEngine.SDK.Views.Pages.ModelsPage"
             x:DataType="vm:ModelsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">

            <!-- 标题 + 描述 + 添加 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Classes="page-title" />
                    <TextBlock Text="{Binding PageDescription}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="AddBtn"
                        Grid.Column="1"
                        Content="{Binding AddModelLabel}"
                        Padding="16,6"
                        Background="{DynamicResource Brush.Accent}"
                        Foreground="{DynamicResource Brush.TextBright}"
                        BorderThickness="0" />
            </Grid>

            <!-- 用法提示 -->
            <Border Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock Text="{Binding AddHint}"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 列表（条目模板在 code-behind 设置：按供应商分组 + 默认模型置顶 + 高亮；关闭虚拟化避免条目高度错估导致文字重叠） -->
            <!-- ItemsSource 必须用 axaml 绑定 GroupedItems——code-behind 的 OnNavigated 先于 DataContext 赋值触发，设置 ItemsSource 不可靠 -->
            <ListBox x:Name="ModelList" ItemsSource="{Binding GroupedItems}" MinHeight="220">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </ControlTheme>
                </ListBox.ItemContainerTheme>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="{Binding EmptyHintText}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Margin="0,4"
                       IsVisible="False" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="EditBtn" Content="{Binding EditModelLabel}" Classes="transparent" Padding="14,6" />
                <Button x:Name="DelBtn"  Content="{Binding DeleteModelLabel}" Classes="transparent" Padding="14,6" />
                <Button x:Name="DefBtn"  Content="{Binding SetDefaultLabel}" Classes="transparent" Padding="14,6" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>