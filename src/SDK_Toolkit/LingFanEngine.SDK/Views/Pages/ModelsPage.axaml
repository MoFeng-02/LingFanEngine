<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LingFanEngine.SDK.ViewModels"
             x:Class="LingFanEngine.SDK.Views.Pages.ModelsPage"
             x:DataType="vm:ModelsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">

            <!-- 标题 + 描述 + 添加 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="模型管理" Classes="page-title" />
                    <TextBlock Text="AI 翻译模型（OpenAI 兼容 / Anthropic），配置保存在本地 models.json。"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="AddBtn"
                        Grid.Column="1"
                        Content="+ 添加模型"
                        Padding="16,6"
                        Background="{DynamicResource Brush.Accent}"
                        Foreground="{DynamicResource Brush.TextBright}"
                        BorderThickness="0" />
            </Grid>

            <!-- 用法提示 -->
            <Border Background="{DynamicResource Brush.CardBg}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8">
                <TextBlock Text="提示：点击「添加模型」→ 填写 Base URL 与 API 密钥 → 点「获取模型列表」即可拉取该端点的全部模型（勾选、默认全选）一键批量添加，也可手动填写「模型 ID」添加单条。"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- 列表（条目模板在 code-behind 设置：按供应商分组 + 默认模型置顶 + 高亮；关闭虚拟化避免条目高度错估导致文字重叠） -->
            <!-- ItemsSource 必须用 axaml 绑定 GroupedItems——code-behind 的 OnNavigated 先于 DataContext 赋值触发，设置 ItemsSource 不可靠 -->
            <ListBox x:Name="ModelList" ItemsSource="{Binding GroupedItems}" MinHeight="220">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="4" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </ControlTheme>
                </ListBox.ItemContainerTheme>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="尚未添加任何模型。点击右上角「添加模型」开始。"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Margin="0,4"
                       IsVisible="False" />

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="EditBtn" Content="编辑" Classes="transparent" Padding="14,6" />
                <Button x:Name="DelBtn"  Content="删除" Classes="transparent" Padding="14,6" />
                <Button x:Name="DefBtn"  Content="设为默认" Classes="transparent" Padding="14,6" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>