<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LingFanEngine.SDK.ViewModels"
             x:Class="LingFanEngine.SDK.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="16">

            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

            <!-- 界面语言 -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="界面语言" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Title}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="150" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="切换语言后，新建/重开的界面生效；当前已打开的窗口需重启后整体刷新。"
                           FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 构建 -->
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="构建" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Title}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <TextBlock Text="默认配置:" Width="120" VerticalAlignment="Center" />
                    <ComboBox x:Name="BuildConfigCombo" MinWidth="120" />
                </StackPanel>
                <CheckBox IsChecked="{Binding DefaultSelfContained}" Content="默认自包含" />
                <CheckBox IsChecked="{Binding DefaultPublishAot}" Content="默认 AOT" />
            </StackPanel>

            <!-- SDK 信息 -->
            <StackPanel Grid.Row="3" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="SDK 信息" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Title}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="SDK 版本:" FontWeight="Bold" Width="120" />
                    <TextBlock Text="{Binding SdkVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="引擎版本:" FontWeight="Bold" Width="120" />
                    <TextBlock Text="{Binding EngineVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="模板版本:" FontWeight="Bold" Width="120" />
                    <TextBlock Text="{Binding TemplateVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text=".NET 版本:" FontWeight="Bold" Width="120" />
                    <TextBlock Text="{Binding DotNetVersion}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="应用数据目录:" FontWeight="Bold" Width="120" />
                    <TextBlock Text="{Binding AppDataDirectory}" />
                </StackPanel>

                <Button Content="打开数据目录" Command="{Binding OpenAppDataCommand}" Margin="0,4,0,0" />
                <Button Content="检查引擎更新" Command="{Binding CheckEngineUpdateCommand}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding EngineUpdateMessage}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                <Button Content="检查模板更新" Command="{Binding CheckTemplateUpdateCommand}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding TemplateUpdateMessage}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- 保存 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"
                        Background="{DynamicResource Brush.Accent}"
                        Foreground="{DynamicResource Brush.TextBright}"
                        BorderThickness="0" Padding="16,6" />
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}" />
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>