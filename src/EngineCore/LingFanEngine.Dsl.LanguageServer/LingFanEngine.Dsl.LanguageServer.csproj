<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- 独立 LSP 服务进程：库自身 100% AOT 兼容（无反射 / 无动态代码生成）；发布期经 PublishAot 产出原生二进制 -->
		<IsAotCompatible>true</IsAotCompatible>
		<InvariantGlobalization>true</InvariantGlobalization>
		<RootNamespace>LingFanEngine.Dsl.LanguageServer</RootNamespace>
		<AssemblyName>LingFan.Dsl.LanguageServer</AssemblyName>
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<!-- 测试项目需访问 internal 类型（DslLanguageServer/JsonRpcConnection/LspTypes）做 wire-level 集成测试 -->
		<InternalsVisibleTo Include="LingFanEngine.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LingFanEngine.Dsl.LanguageService\LingFanEngine.Dsl.LanguageService.csproj" />
	</ItemGroup>

</Project>
