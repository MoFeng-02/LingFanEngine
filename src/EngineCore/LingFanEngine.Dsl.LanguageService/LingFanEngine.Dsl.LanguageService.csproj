<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- 语言服务纯逻辑层：库自身 100% AOT 兼容（无反射 / 无动态代码生成） -->
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\LingFanEngine.DslCore\LingFanEngine.DslCore.csproj" />
		<ProjectReference Include="..\LingFanEngine.Dsl.ProjectIndex\LingFanEngine.Dsl.ProjectIndex.csproj" />
	</ItemGroup>

	<!-- 允许单元测试工程访问 internal 格式化逻辑（DslFormatter 等）。Tests 程序集未强签名，故仅写程序集名。 -->
	<ItemGroup>
		<InternalsVisibleTo Include="LingFanEngine.Tests" />
	</ItemGroup>

</Project>
