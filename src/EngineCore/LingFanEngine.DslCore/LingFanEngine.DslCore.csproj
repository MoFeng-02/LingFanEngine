<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- Native AOT 兼容声明（库项目，实际 AOT 编译在可执行项目上） -->
		<IsAotCompatible>true</IsAotCompatible>

		<!-- NuGet 包元数据（2026-09 起引擎经 NuGet 分发，替代 4-DLL zip 模式） -->
		<!-- CI 发布时以 -p:Version=<tag> 覆盖版本 -->
		<Version>0.3.0</Version>
		<PackageId>LingFanEngine.DslCore</PackageId>
		<Authors>MoFeng-02</Authors>
		<Description>灵泛引擎 DSL 共享解析层（基于 Parlot 的场景/语句/元素解析器，供引擎与 LSP 共用）</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/MoFeng-02/LingFanEngine</PackageProjectUrl>
		<RepositoryUrl>https://github.com/MoFeng-02/LingFanEngine</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>visual-novel;engine;parser;parlot;dsl</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Parlot" Version="1.5.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LingFanEngine.Abstractions\LingFanEngine.Abstractions.csproj" />
	</ItemGroup>

</Project>
