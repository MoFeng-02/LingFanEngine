<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<!-- 默认（中性）语言：简体中文；AppLang.*.resx 随当前 UI 文化回退 -->
		<NeutralLanguage>zh-Hans</NeutralLanguage>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<!-- Native AOT 兼容声明（库项目，实际 AOT 编译在可执行项目上） -->
		<IsAotCompatible>true</IsAotCompatible>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="MFToolkit.Abstractions" Version="1.0.20" />
		<PackageReference Include="MFToolkit.AutoGenerator" Version="1.0.20" />
		<PackageReference Include="MFToolkit.Routing" Version="1.1.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="DependencyInjection\" />
		<Folder Include="Models\" />
		<Folder Include="Compilers\" />
		<Folder Include="Cryptography\" />
		<Folder Include="Resources\" />
		<Folder Include="Services\Abstractions\" />
		<Folder Include="Services\Implementations\" />
		<Folder Include="Utils\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\EngineCore\LingFanEngine.DslCore\LingFanEngine.DslCore.csproj" />
	</ItemGroup>

	<!-- 引擎依赖经 NuGet 传递（2026-09 起引擎以 NuGet 包分发，SDK 不再携带/同步 DLL 种子）：
	     DslCore 的 ProjectReference 仅供 SDK 自身编译使用；用户项目经 PackageReference 还原。 -->

	<!-- P2-1: 模板 ZIP 嵌入资源 -->
	<!-- 构建时把 src/Template/V1 打包为 template.zip 并嵌入程序集 -->
	<!-- 仅在 PackTemplate=true 时启用（分发构建时设置） -->
	<Target Name="PackTemplateZip" BeforeTargets="PrepareForBuild" Condition="'$(PackTemplate)' == 'true'">
		<PropertyGroup>
			<TemplateSourceDir>$(MSBuildThisFileDirectory)..\..\Template\V1</TemplateSourceDir>
			<TemplateZipPath>$(IntermediateOutputPath)template.zip</TemplateZipPath>
			<PackTemplateScript>$(MSBuildThisFileDirectory)..\..\pack-template.ps1</PackTemplateScript>
		</PropertyGroup>
		<!-- 使用 PowerShell 脚本打包 ZIP（排除 bin/obj/.vs/.git） -->
		<Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(PackTemplateScript)&quot; -SourceDir &quot;$(TemplateSourceDir)&quot; -OutputFile &quot;$(TemplateZipPath)&quot;" />
		<ItemGroup>
			<EmbeddedResource Include="$(TemplateZipPath)" />
		</ItemGroup>
	</Target>
</Project>
